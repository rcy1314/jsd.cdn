{
  "name": "jsd-cdn-accelerator",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/node.ts",
    "dev:node": "tsx watch src/node.ts",
    "build": "tsup src/node.ts --format esm --platform node --target node20 --out-dir dist",
    "build:node": "npm run build",
    "start": "node dist/node.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.10.0",
    "hono": "^4.9.0",
    "jose": "^6.2.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.2",
    "tsup": "^8.3.6",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3",
    "wrangler": "^3.114.0"
  }
}
